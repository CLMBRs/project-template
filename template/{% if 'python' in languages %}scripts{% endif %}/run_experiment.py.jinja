"""Run an example experiment, as a model for real experiment scripts.

Draws random numbers and saves their mean, to show the pattern every experiment script
should follow: read all settings from a config, seed randomness, log what happened,
and write results to a fresh output directory.

Usage:
{%- if use_hydra %}
    uv run python scripts/run_experiment.py
    uv run python scripts/run_experiment.py seed=1 experiment.num_samples=500
    uv run python scripts/run_experiment.py --multirun seed=0,1,2
{%- else %}
    uv run python scripts/run_experiment.py --config config/config.yaml
{%- endif %}
"""

{% if not use_hydra -%}
import argparse
{% endif -%}
import json
import logging
import random
import statistics
from pathlib import Path

{% if use_hydra -%}
import hydra
from hydra.core.hydra_config import HydraConfig
from omegaconf import DictConfig, OmegaConf
{%- else -%}
import yaml
{%- endif %}

from {{ package_name }}.seeding import set_seed

logger = logging.getLogger(__name__)
{% if use_hydra %}

@hydra.main(version_base="1.3", config_path="../config", config_name="config")
def main(config: DictConfig) -> None:
    """Run the experiment described by `config`."""
    # log the full config, so every run records exactly how it was produced
    logger.info("Config:\n%s", OmegaConf.to_yaml(config))
    output_dir = Path(HydraConfig.get().runtime.output_dir)

    set_seed(config.seed)
    samples = [random.random() for _ in range(config.experiment.num_samples)]
    results = {"mean": statistics.mean(samples), "num_samples": len(samples)}

    logger.info("Results: %s", results)
    (output_dir / "results.json").write_text(json.dumps(results, indent=2))
{%- else %}

def main() -> None:
    """Run the experiment described by the config file given on the command line."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", type=Path, default=Path("config/config.yaml"))
    args = parser.parse_args()
    config = yaml.safe_load(args.config.read_text())
    # log the full config, so every run records exactly how it was produced
    logger.info("Config: %s", config)
    output_dir = Path("outputs") / config["experiment"]["name"]
    output_dir.mkdir(parents=True, exist_ok=True)

    set_seed(config["seed"])
    samples = [random.random() for _ in range(config["experiment"]["num_samples"])]
    results = {"mean": statistics.mean(samples), "num_samples": len(samples)}

    logger.info("Results: %s", results)
    (output_dir / "results.json").write_text(json.dumps(results, indent=2))
{%- endif %}


if __name__ == "__main__":
{%- if not use_hydra %}
    logging.basicConfig(level=logging.INFO)
{%- endif %}
    main()
