name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  python:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - uses: astral-sh/setup-uv@v7
        with:
          enable-cache: true
      - name: Install environment
        run: uv sync --locked
      - name: Run pre-commit checks
        run: uv run pre-commit run --all-files --show-diff-on-failure
      - name: Run tests
        run: uv run pytest
