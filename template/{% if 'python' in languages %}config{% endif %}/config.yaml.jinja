{%- if use_hydra -%}
# Default experiment config, composed by Hydra (https://hydra.cc).
# Override any value from the command line, e.g.
#   uv run python scripts/run_experiment.py seed=1 experiment.num_samples=500
# or sweep over values with --multirun:
#   uv run python scripts/run_experiment.py --multirun seed=0,1,2
defaults:
  - _self_

seed: 0

experiment:
  name: example
  num_samples: 1000

hydra:
  run:
    dir: outputs/${experiment.name}/${now:%Y-%m-%d_%H-%M-%S}
  sweep:
    dir: outputs/${experiment.name}/multirun/${now:%Y-%m-%d_%H-%M-%S}
    subdir: ${hydra.job.num}
{%- else -%}
# Default experiment config.
#   uv run python scripts/run_experiment.py --config config/config.yaml
seed: 0

experiment:
  name: example
  num_samples: 1000
{%- endif %}
